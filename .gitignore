MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nosenv/
.pytest_cache/
.abspath
.cache
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.run/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Sphinx documentation
doc/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or app, you might want to share your .python-version.
#   Only uncomment if you are using pyenv.
#.python-version

# pipenv
#   According to pypa/pipenv#1291, pipenv should write instead of user.
#   So we should not put Pipfile.lock in git.
#Pipfile.lock

# poetry
#   Poetry uses poetry.lock to store resolved dependencies.
#   It is recommended to commit poetry.lock to git.
#poetry.lock

# pdm
#   PDM stores project-wide configurations in .pdm.toml
#   and local configurations in .pdm-local.toml
.pdm.toml
.pdm-local.toml
.pdm-db/

# virtualenv
.venv/
venv/
ENV/
env/
active/

# IDEs
.idea/
.vscode/
*.swp
*.swo

# Project specific ignores
artifacts/defect_risk_model.joblib
frontend/__pycache__/
backend/__pycache__/
backend/services/__pycache__/
.system_generated/
